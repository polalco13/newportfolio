{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polalco",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // El Worker elige el idioma de estas tres páginas y sirve y cuenta los PDFs.
    // Todo lo demás sale directamente de los assets.
    "run_worker_first": ["/", "/alco", "/cv", "/alco.pdf", "/cv.pdf"]
  },
  // Una fila por descarga: documento, origen, ref, país e idioma. Sin IP ni cookies.
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "polalco_downloads" }],
  // Sin Workers Logs: los registros de cada petición llevarían cabeceras y la página de
  // privacidad dice que no se guarda nada que identifique a nadie.
  "observability": { "enabled": false }
}
