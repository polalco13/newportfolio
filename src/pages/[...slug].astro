---
// Nueve páginas: el vestíbulo (/), ALCO (/alco) y el ingeniero (/dev) sin idioma (el Worker o el
// middleware eligen el del navegador) y las mismas tres con el idioma fijo en /es, /ca y /en.
import Landing from '../components/Landing.astro';
import AlcoPage from '../components/AlcoPage.astro';
import DevPage from '../components/DevPage.astro';
import { LANGS, DEFAULT_LANG, SUBWEBS, pagePath, type PageId } from '../../shared/site';

export function getStaticPaths() {
  const pages: PageId[] = ['home', ...SUBWEBS];
  const slug = (path: string) => path.replace(/^\//, '') || undefined;
  return [
    ...pages.map((page) => ({ params: { slug: slug(pagePath(page)) }, props: { page, lang: DEFAULT_LANG, negotiated: true } })),
    ...LANGS.flatMap((lang) =>
      pages.map((page) => ({ params: { slug: slug(pagePath(page, lang)) }, props: { page, lang, negotiated: false } })),
    ),
  ];
}

const { page, lang, negotiated } = Astro.props;
---

{page === 'home' && <Landing lang={lang} negotiated={negotiated} />}
{page === 'alco' && <AlcoPage lang={lang} negotiated={negotiated} />}
{page === 'dev' && <DevPage lang={lang} negotiated={negotiated} />}
