---
// «Cómo trabajo»: a la izquierda el título, la idea en una frase grande y cuatro datos; a la derecha,
// una foto alta que se abre como una persiana. Bajo la foto cabe una nota (slot `caption`).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  body: string;
  facts: { big: string; small: string }[];
  image: ImageMetadata;
  alt: string;
}

const { id, title, body, facts, image, alt } = Astro.props;
---

<section class="intro pad" id={id} aria-labelledby={`${id}-t`}>
  <div class="text">
    <h2 class="sec-title" id={`${id}-t`} data-reveal>{title}</h2>
    <p class="statement" data-reveal style="--d: 90ms">{body}</p>
    <ul class="facts">
      {
        facts.map((f, i) => (
          <li data-reveal style={`--d: ${120 + i * 70}ms`}>
            <b>{f.big}</b>
            <span>{f.small}</span>
          </li>
        ))
      }
    </ul>
    <slot />
  </div>
  <figure>
    <div class="ph" data-shutter>
      <Image src={image} alt={alt} widths={[600, 1000]} sizes="(max-width: 760px) 92vw, 40vw" format="webp" quality={72} loading="lazy" />
    </div>
    {
      Astro.slots.has('caption') && (
        <figcaption data-reveal>
          <slot name="caption" />
        </figcaption>
      )
    }
  </figure>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
    padding-block: 160px 150px;
  }
  .text {
    grid-column: 1 / 8;
    padding-top: 8px;
  }
  .statement {
    margin: 36px 0 0;
    max-width: 22em;
    font-size: var(--s3);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
    max-width: 660px;
    margin: 88px 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .facts b {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .facts span {
    color: var(--muted);
    max-width: 26ch;
  }
  figure {
    grid-column: 8 / 13;
    margin: 0;
  }
  .ph {
    overflow: hidden;
  }
  .ph :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  figcaption {
    margin-top: 16px;
    max-width: 40ch;
  }
  @media (max-width: 1024px) {
    .text {
      grid-column: 1 / 13;
    }
    figure {
      grid-column: 1 / 13;
      max-width: 520px;
      margin-top: 40px;
    }
  }
  @media (max-width: 760px) {
    .intro {
      padding-block: 96px 88px;
    }
    .statement {
      margin-top: 24px;
    }
    .facts {
      gap: 28px 20px;
      margin-top: 56px;
    }
    .facts b {
      font-size: 19px;
    }
  }
</style>
