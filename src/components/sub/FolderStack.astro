---
// El montón de carpetas con pestaña de la portada de cada subweb. La de delante está abierta; las demás
// enseñan su franja. Sin JavaScript, la hoja de debajo enseña todas las carpetas seguidas;
// src/scripts/folders.ts reordena el montón al pulsar una pestaña.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PdfButton from '../PdfButton.astro';
import type { DocId, Lang } from '../../../shared/site';

export interface Folder {
  id: string;
  color: string;
  tab: string;
  count: string;
  title: string;
  what: string;
  cta: { label: string; href: string; type?: string };
  peek: { a: string; b: string }[];
  more: { label: string; href: string };
  image?: ImageMetadata;
  caption?: string;
  /** Sin foto: una ficha de texto del mismo tamaño. */
  card?: { big: string; small: string };
}

interface Props {
  folders: Folder[];
  front: string;
  label: string;
  lang: Lang;
  /** El PDF de la subweb, como enlace dentro de la carpeta abierta. */
  doc: DocId;
  src: string;
  /** Si el avance lleva hora (momentos) o un nombre con su nota (proyectos). */
  timed?: boolean;
  /** Para los enlaces de la barra. */
  id?: string;
}

const { folders, front, label, lang, doc, src, timed = true, id } = Astro.props;
// Las tres primeras pestañas se cuentan desde la izquierda y las dos últimas desde la derecha, para que
// ninguna se salga de la pantalla en el móvil.
const POS = ['--x: 3%', '--x: 21%', '--x: 42%', '--r: 17%', '--r: 3%'];
const order = (id: string, i: number) => (id === front ? 99 : i);
---

<div class:list={['stack', { timed }]} id={id} data-anchor data-stack data-label={label}>
  {
    folders.map((f, i) => (
      <div
        class:list={['folder', { front: f.id === front }]}
        data-id={f.id}
        data-color={f.color}
        style={`--c: var(--${f.color}); ${POS[i % POS.length]}; --i: ${i}; --o: ${order(f.id, i)}`}
      >
        <button class="tab" type="button" id={`tab-${f.id}`} tabindex="-1">
          {f.tab}
        </button>
        <span class="count">{f.count}</span>
        <div class="body" id={`body-${f.id}`}>
          <div>
            <h2>{f.title}</h2>
            <p class="what">{f.what}</p>
            <a class="btn cut" href={f.cta.href} data-type={f.cta.type}>
              {f.cta.label}
            </a>
            <div class="pdf-in">
              <PdfButton lang={lang} doc={doc} src={src} />
            </div>
          </div>
          <ol class="peek">
            {f.peek.map((p) => (
              <li>
                <b>{p.a}</b>
                <span>{p.b}</span>
              </li>
            ))}
            <li class="more">
              <b />
              <a class="link" href={f.more.href}>
                {f.more.label}
              </a>
            </li>
          </ol>
          <figure>
            {f.image ? (
              <Image src={f.image} alt="" widths={[480, 760]} sizes="(max-width: 1024px) 0px, 28vw" format="webp" quality={72} />
            ) : (
              f.card && (
                <div class="card-img" aria-hidden="true">
                  <b>{f.card.big}</b>
                  <span>{f.card.small}</span>
                </div>
              )
            )}
            {f.caption && <figcaption>{f.caption}</figcaption>}
          </figure>
        </div>
      </div>
    ))
  }
</div>

<script>
  import '../../scripts/folders';
</script>

<style>
  .stack {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 86vw;
    margin: clamp(36px, 7vh, 72px) auto 0;
    padding-top: 40px;
    view-transition-name: stack;
  }
  .folder {
    position: relative;
    order: var(--o);
    background: var(--c);
    color: var(--ink);
  }
  .folder:not(.front) {
    height: 64px;
  }
  .folder:not(.front) .body {
    display: none;
  }
  .tab {
    position: absolute;
    bottom: 100%;
    left: var(--x, auto);
    right: var(--r, auto);
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 30px;
    border: 0;
    background: var(--c);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 100%, 0 100%);
    transition: transform 180ms var(--ease);
  }
  /* Sin JavaScript las pestañas no hacen nada: la hoja de debajo ya enseña todas las carpetas. */
  .tab {
    cursor: default;
  }
  :global(.js) .folder:not(.front) .tab {
    cursor: pointer;
  }
  :global(.js) .folder:not(.front) .tab:hover {
    transform: translateY(-4px);
  }
  .count {
    position: absolute;
    right: 40px;
    top: 0;
    height: 24px;
    display: flex;
    align-items: center;
    font-size: var(--s1);
    font-variant-numeric: tabular-nums;
  }
  .folder.front .count {
    display: none;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px 48px;
    padding: 40px 40px 72px;
    align-items: start;
  }
  .body h2 {
    margin: 0;
    font-size: var(--s4);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .what {
    margin: 14px 0 0;
    max-width: 34ch;
  }
  .btn.cut {
    margin-top: 28px;
    clip-path: polygon(10px 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%, 0 10px);
  }
  .pdf-in {
    margin-top: 16px;
  }
  .peek {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .peek li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
  }
  .timed .peek li {
    grid-template-columns: 64px 1fr;
    gap: 0;
  }
  .stack:not(.timed) .peek li.more b {
    display: none;
  }
  .peek b {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  figure {
    margin: 0;
  }
  figure {
    overflow: hidden;
  }
  figure :global(img),
  .card-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
  }
  figure :global(img) {
    transition: transform 900ms var(--ease-soft);
  }
  .body:hover figure :global(img) {
    transform: scale(1.04);
  }
  .card-img {
    display: grid;
    align-content: end;
    gap: 8px;
    padding: 24px;
    background: var(--ink);
    color: var(--c);
  }
  .card-img b {
    font-size: var(--s3);
    font-weight: 300;
    color: var(--paper);
  }
  figcaption {
    margin-top: 8px;
    font-size: var(--s1);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .folder {
      animation: slide 900ms var(--ease) both;
      animation-delay: calc(360ms + var(--i) * 90ms);
    }
  }
  @keyframes slide {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
  }
  @media (max-width: 1024px) {
    .body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    figure {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .stack {
      width: 100%;
      margin-top: 48px;
      padding-top: 32px;
    }
    .folder:not(.front) {
      height: 52px;
    }
    .tab {
      height: 32px;
      padding: 0 18px;
    }
    .count {
      display: none;
    }
    .body {
      grid-template-columns: 1fr;
      padding: 24px 16px 80px;
      gap: 24px;
    }
    .btn.cut {
      width: 100%;
    }
  }
</style>
