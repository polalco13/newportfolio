---
// Portada de /dev, «Necesito a alguien que…»: una frase que el visitante completa con un desplegable, y la
// página responde con los proyectos de ese tipo de trabajo. El desplegable es propio (un popover con
// role=listbox), no el <select> del sistema. Sin JavaScript se ven todos los tipos uno debajo de otro y
// cada opción del desplegable es un enlace a su bloque.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import PdfButton from '../PdfButton.astro';
import type { Lang } from '../../../shared/site';

export interface Work {
  name: string;
  meta: string;
  text: string;
  image?: ImageMetadata;
  card?: { big: string; small: string };
  role: { label: string; value: string };
  tags: string[];
  links: { label: string; href: string }[];
}
export interface Area {
  id: string;
  color: string;
  title: string;
  need: string;
  line: string;
  source: string;
  note: string;
  items: Work[];
}
interface Props {
  id: string;
  lang: Lang;
  areas: Area[];
  front: string;
  portrait: ImageMetadata;
  portraitAlt: string;
  cta: string;
  copy: { who: string; ask: string; pick: string; quick: string; others: string };
}

const { id, lang, areas, front, portrait, portraitAlt, cta, copy } = Astro.props;
const first = areas.find((a) => a.id === front) ?? areas[0];
/** Una captura de móvil (más alta que ancha) se enseña entera, sin recortar. */
const tall = (img: ImageMetadata) => img.height > img.width;
---

<section class="need-hero pad" aria-labelledby={id} data-need style={`--ar: var(--${first.color})`}>
  <div class="left">
    <div class="who">
      <Image class="avatar" src={portrait} alt="" widths={[160]} sizes="64px" format="webp" quality={72} loading="eager" />
      <h1 id={id}>{copy.who}</h1>
    </div>
    <p class="ask">
      <span id="need-ask">{copy.ask}</span>
      {' '}
      <button
        type="button"
        class="pick"
        id="need-pick"
        popovertarget="need-list"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="need-list"
        aria-labelledby="need-ask need-value"
      >
        <span class="hl"><span id="need-value" data-need-value>{first.need}</span><ChevronDown class="chev" stroke-width={1.5} aria-hidden="true" /></span>
      </button>
    </p>
    <div class="menu" id="need-list" popover role="listbox" aria-label={copy.pick}>
      {
        areas.map((a, i) => (
          <a
            class="opt"
            href={`#m-${a.id}`}
            role="option"
            tabindex="-1"
            id={`need-opt-${a.id}`}
            data-opt={a.id}
            aria-selected={String(a.id === first.id)}
            style={`--c: var(--${a.color}); --i: ${i}`}
          >
            <span class="dot" aria-hidden="true" />
            <span class="say">
              <b>{a.need}</b>
              <small>{a.items.map((w) => w.name).join(' · ')}</small>
            </span>
            <Check class="tick" size={20} stroke-width={1.5} aria-hidden="true" />
          </a>
        ))
      }
    </div>
    <div class="quick" role="group" aria-label={copy.quick}>
      {
        areas.map((a) => (
          <button type="button" data-area-pick={a.id} aria-pressed={String(a.id === first.id)} style={`--c: var(--${a.color})`}>
            {a.title}
          </button>
        ))
      }
    </div>
    <div class="actions">
      <a class="btn" href="#escribeme">{cta}</a>
      <PdfButton lang={lang} doc="cv" src="web-dev" />
    </div>
  </div>
  <Image class="portrait" src={portrait} alt={portraitAlt} widths={[480, 760]} sizes="(max-width: 1100px) 0px, 30vw" format="webp" quality={72} loading="eager" />
</section>

<p class="sr" aria-live="polite" data-need-status></p>

<section class="answer pad" id="proyectos" style={`--ar: var(--${first.color})`}>
  {
    areas.map((a) => (
      <div class="area" id={`m-${a.id}`} data-area={a.id} style={`--c: var(--${a.color})`}>
        <h2 class="lead" data-reveal>
          {a.line}
        </h2>
        <p class="source" data-reveal>
          <b>{a.source}</b> <span>· {a.note}</span>
        </p>
        <div class="works">
          {a.items.map((w, i) => (
            <article class:list={['work', { main: i === 0 }]} data-reveal>
              <div class="vis">
                {w.image ? (
                  <Image class:list={{ tall: tall(w.image) }} src={w.image} alt="" widths={[480, 760, 1200]} sizes={i === 0 ? '(max-width: 960px) 92vw, 56vw' : '(max-width: 960px) 92vw, 30vw'} format="webp" quality={70} loading="lazy" />
                ) : (
                  w.card && (
                    <div class="card" aria-hidden="true">
                      <b>{w.card.big}</b>
                      <span>{w.card.small}</span>
                    </div>
                  )
                )}
              </div>
              <div class="txt">
                <h3>{w.name}</h3>
                <p class="role">
                  {w.role.value} · {w.meta}
                </p>
                <p>{w.text}</p>
                <ul class="tags">
                  {w.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {w.links.length > 0 && (
                  <p class="links">
                    {w.links.map((l) => (
                      <a class="link" href={l.href}>
                        {l.label}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
  <div class="others">
    <p>{copy.others}</p>
    <div class="quick">
      {
        areas.map((a) => (
          <button type="button" data-area-pick={a.id} aria-pressed={String(a.id === first.id)} style={`--c: var(--${a.color})`}>
            {a.title}
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-need]');
  const answer = document.getElementById('proyectos');
  const trigger = document.querySelector<HTMLButtonElement>('#need-pick');
  const menu = document.querySelector<HTMLElement>('#need-list');
  const value = document.querySelector<HTMLElement>('[data-need-value]');
  const opts = [...document.querySelectorAll<HTMLAnchorElement>('[data-opt]')];
  let current = opts.find((o) => o.getAttribute('aria-selected') === 'true')?.dataset.opt ?? opts[0]?.dataset.opt;
  let started = false;

  function show(id: string, scroll = false) {
    current = id;
    opts.forEach((o) => o.setAttribute('aria-selected', String(o.dataset.opt === id)));
    const chosen = opts.find((o) => o.dataset.opt === id);
    if (value && chosen) value.textContent = chosen.querySelector('b')!.textContent;
    document.querySelectorAll<HTMLElement>('[data-area-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.areaPick === id)));
    document.querySelectorAll<HTMLElement>('[data-area]').forEach((a) => (a.hidden = a.dataset.area !== id));
    const color = getComputedStyle(document.querySelector<HTMLElement>(`[data-area="${id}"]`)!).getPropertyValue('--c');
    hero?.style.setProperty('--ar', color);
    answer?.style.setProperty('--ar', color);
    document.querySelectorAll(`[data-area="${id}"] [data-reveal]`).forEach((el) => el.classList.add('is-in'));
    const status = document.querySelector('[data-need-status]');
    if (status && started) status.textContent = document.querySelector(`[data-area="${id}"] .lead`)?.textContent?.trim() ?? '';
    if (scroll) answer?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }

  // El menú se abre pegado a la frase, debajo. Si no cabe, la página sube lo justo (sin esconder la frase
  // bajo la barra); solo si ni así cabe se abre encima. Nunca sale de la pantalla.
  function place(opening = false) {
    if (!trigger || !menu) return;
    const gap = 10;
    const edge = 16;
    menu.classList.add('placed');
    menu.style.maxHeight = '';
    const h = menu.offsetHeight;
    if (opening) {
      const r0 = trigger.getBoundingClientRect();
      const short = r0.bottom + gap + h + edge - innerHeight;
      const bar = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--bar')) || 64;
      const lift = Math.min(short, r0.top - bar - edge, document.documentElement.scrollHeight - innerHeight - scrollY);
      if (short > 0 && lift > 0) scrollBy({ top: lift, behavior: 'instant' });
    }
    const r = trigger.getBoundingClientRect();
    const w = Math.min(menu.offsetWidth, innerWidth - edge * 2);
    const below = innerHeight - r.bottom - gap - edge;
    const above = r.top - gap - edge;
    const up = h > below && above > below;
    const room = up ? above : below;
    menu.style.maxHeight = `${Math.max(room, 220)}px`;
    menu.style.left = `${Math.max(edge, Math.min(r.left, innerWidth - w - edge))}px`;
    menu.style.top = up ? `${Math.max(edge, r.top - gap - Math.min(h, room))}px` : `${r.bottom + gap}px`;
    menu.dataset.side = up ? 'up' : 'down';
  }

  const isOpen = () => !!menu?.matches(':popover-open');
  const focusOpt = (i: number) => opts[(i + opts.length) % opts.length]?.focus();
  const index = () => opts.indexOf(document.activeElement as HTMLAnchorElement);

  function open(at?: 'first' | 'last') {
    if (!menu) return;
    if (!isOpen()) menu.showPopover();
    const sel = opts.findIndex((o) => o.dataset.opt === current);
    focusOpt(at === 'first' ? 0 : at === 'last' ? opts.length - 1 : Math.max(sel, 0));
  }
  function close(refocus = true) {
    if (isOpen()) menu!.hidePopover();
    if (refocus) trigger?.focus();
  }

  menu?.addEventListener('toggle', (e) => {
    const opened = (e as ToggleEvent).newState === 'open';
    trigger?.setAttribute('aria-expanded', String(opened));
    if (opened) {
      place(true);
      // Con ratón el foco va a la opción elegida, para poder seguir con las flechas.
      if (!menu.contains(document.activeElement)) open();
    }
  });
  trigger?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      open(e.key === 'ArrowUp' ? 'last' : undefined);
    }
  });
  menu?.addEventListener('keydown', (e) => {
    const i = index();
    if (e.key === 'ArrowDown') focusOpt(i + 1);
    else if (e.key === 'ArrowUp') focusOpt(i - 1);
    else if (e.key === 'Home') focusOpt(0);
    else if (e.key === 'End') focusOpt(opts.length - 1);
    else if (e.key === ' ' || e.key === 'Enter') (document.activeElement as HTMLElement)?.click();
    else if (e.key === 'Escape') close();
    else if (e.key === 'Tab') return close(false);
    else return;
    e.preventDefault();
  });
  opts.forEach((o) => {
    o.addEventListener('click', (e) => {
      e.preventDefault();
      show(o.dataset.opt!);
      close();
    });
    o.addEventListener('pointermove', () => o !== document.activeElement && o.focus({ preventScroll: true }));
  });
  addEventListener('resize', () => isOpen() && place());
  addEventListener('scroll', () => isOpen() && place(), { passive: true });

  document.querySelectorAll<HTMLElement>('[data-area-pick]').forEach((b) =>
    b.addEventListener('click', () => show(b.dataset.areaPick!, !!b.closest('.others'))),
  );
  if (current) {
    show(current);
    started = true;
  }
</script>

<style>
  .need-hero {
    display: grid;
    gap: 28px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .need-hero .ask {
      font-size: clamp(22px, 6.8vw, 34px);
    }
  }
  .left {
    display: grid;
    gap: 28px;
    align-content: end;
    min-width: 0;
  }
  .need-hero {
    padding-top: calc(var(--bar) + 40px);
    padding-bottom: 72px;
  }
  .portrait {
    display: none;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .who :global(.avatar) {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }
  .who h1 {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(19px, 1.5vw, 24px);
    font-weight: 500;
    line-height: 1.3;
  }
  .ask {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(22px, 4.6vw, 80px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.045em;
    view-transition-name: headline;
  }
  /* La opción elegida, subrayada con el color de su tipo de trabajo; si no cabe, parte en líneas. */
  .pick {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
  }
  .pick:focus-visible {
    outline: none;
  }
  .pick:focus-visible .hl {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .hl {
    padding: 0 0.12em 0.02em 0.16em;
    background: var(--ar);
    color: var(--ink);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-color 300ms ease;
  }
  .hl :global(.chev) {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.08em;
    vertical-align: 0.02em;
    stroke-width: 2.2;
    transition: transform 260ms var(--ease);
  }
  .pick[aria-expanded='true'] .hl :global(.chev) {
    transform: rotate(180deg);
  }
  @media (hover: hover) {
    .pick:hover .hl :global(.chev) {
      transform: translateY(0.06em);
    }
    .pick[aria-expanded='true']:hover .hl :global(.chev) {
      transform: rotate(180deg);
    }
  }

  /* El menú: una ficha oscura en la capa superior con las cinco respuestas posibles. */
  .menu {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--paper) 30%, transparent) transparent;
    border: 0;
    border-radius: 14px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 24px 60px -18px rgb(26 20 32 / 0.45);
    opacity: 1;
    transform: none;
    transform-origin: top left;
    transition:
      opacity 180ms ease,
      transform 220ms var(--ease),
      overlay 220ms allow-discrete,
      display 220ms allow-discrete;
  }
  .menu.placed {
    position: fixed;
    inset: auto;
    margin: 0;
  }
  .menu[data-side='up'] {
    transform-origin: bottom left;
  }
  .menu:not(:popover-open) {
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }
  .menu::backdrop {
    background: transparent;
  }
  .opt {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 16px 14px 14px;
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
    outline: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  .opt + .opt {
    margin-top: 2px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c);
    transition: transform 200ms var(--ease);
  }
  .say {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .say b {
    font-size: clamp(20px, 1rem + 0.9vw, 26px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .say small {
    overflow: hidden;
    color: color-mix(in oklab, currentColor 62%, transparent);
    font-size: 14px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .opt :global(.tick) {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 160ms ease,
      transform 220ms var(--ease);
  }
  .opt[aria-selected='true'] :global(.tick) {
    opacity: 1;
    transform: none;
  }
  .opt:focus-visible,
  .opt:focus {
    background: var(--c);
    color: var(--ink);
  }
  .opt:focus .dot {
    transform: scale(0);
  }
  .opt:active {
    transform: scale(0.99);
  }
  @media (max-width: 480px) {
    .menu {
      padding: 6px;
    }
    .opt {
      gap: 12px;
      padding: 11px 12px 11px 12px;
    }
    .dot {
      width: 10px;
      height: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu:not(:popover-open) {
      transform: none;
    }
    @starting-style {
      .menu:popover-open {
        transform: none;
      }
    }
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .quick button {
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    background: color-mix(in oklab, var(--ink) 7%, transparent);
    color: inherit;
    font: inherit;
    font-size: 16px;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      transform 140ms var(--ease);
  }
  .quick button:hover {
    transform: translateY(-1px);
  }
  .quick button:active {
    transform: scale(0.97);
  }
  .quick button[aria-pressed='true'] {
    background: var(--c);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (min-width: 1100px) {
    .need-hero {
      grid-template-columns: 8fr 4fr;
      column-gap: 48px;
      align-items: end;
      min-height: 92svh;
    }
    .need-hero :global(.portrait) {
      display: block;
      align-self: end;
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
  }

  /* La respuesta: el primer proyecto en grande y los demás debajo. */
  .answer {
    padding-block: 40px 140px;
  }
  .area[hidden] {
    display: none;
  }
  .lead {
    margin: 0;
    max-width: 30ch;
    font-size: var(--s3);
    font-weight: 400;
    line-height: 1.25;
  }
  .source {
    margin: 12px 0 48px;
    color: var(--muted);
  }
  .source b {
    color: var(--fg);
    font-weight: 600;
  }
  .works {
    display: grid;
    gap: 72px;
  }
  .work {
    display: grid;
    gap: 20px;
    align-items: end;
  }
  .vis {
    container-type: inline-size;
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }
  .vis :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .vis :global(img.tall) {
    object-fit: contain;
  }
  .card {
    display: grid;
    align-content: end;
    gap: 10px;
    aspect-ratio: 16 / 10;
    padding: 28px;
    background: var(--c);
    color: var(--ink);
  }
  .card b {
    /* La palabra llena la ficha sin partirse: «Opsmonitor» cabe igual en la grande que en la pequeña. */
    font-size: min(15cqi, 140px);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .work h3 {
    margin: 0 0 8px;
    font-size: var(--s4);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .work p {
    margin: 0 0 14px;
    max-width: 46ch;
  }
  .role {
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 4px 10px;
    background: color-mix(in oklab, var(--ink) 7%, transparent);
    font-size: 15px;
  }
  .links {
    display: flex;
    gap: 20px;
  }
  .others {
    margin-top: 96px;
  }
  .others p {
    margin: 0 0 12px;
    color: var(--muted);
  }
  @media (min-width: 960px) {
    .work.main {
      grid-template-columns: 7fr 5fr;
      gap: 48px;
    }
    .work:not(.main) {
      grid-template-columns: 4fr 8fr;
      gap: 40px;
    }
    .work:not(.main) h3 {
      font-size: var(--s3);
    }
  }
</style>
