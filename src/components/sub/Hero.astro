---
// Portada de cada subweb: el titular en dos líneas, una frase y, debajo, el montón de carpetas (slot).
// Con `image`, la foto llena la parte alta a sangre, oscurecida, y las carpetas salen por delante.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  headline: [string, string];
  lede: string;
  image?: ImageMetadata;
}

const { id, headline, lede, image } = Astro.props;
---

<section class:list={['hero', { photo: image }]} aria-labelledby={id}>
  {
    image && (
      <div class="bg" aria-hidden="true">
        <Image src={image} alt="" widths={[760, 1200, 1800]} sizes="100vw" format="webp" quality={68} loading="eager" fetchpriority="high" />
      </div>
    )
  }
  <h1 class="name" id={id}>
    {
      headline.map((line, i) => (
        <span class="ln" style={`--i: ${i}`}>
          <span>{line}</span>
        </span>
      ))
    }
  </h1>
  <p class="lede pad">{lede}</p>
  <slot />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: var(--bar);
    display: grid;
    grid-template-rows: auto auto 1fr;
  }
  .bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(86svh, 820px);
    overflow: hidden;
    background: var(--night-2);
  }
  .bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  /* Velo neutro sobre la foto, para que el titular se lea. */
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 17 28 / 0.6);
  }
  .name,
  .lede {
    position: relative;
  }
  .name {
    margin: clamp(28px, 6vh, 72px) auto 0;
    padding: 0 16px;
    font-size: var(--s5);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-align: center;
    view-transition-name: headline;
  }
  /* Cada línea sube desde detrás de su propio borde. El relleno deja sitio a acentos y comas. */
  .ln {
    display: block;
    overflow: clip;
    padding: 0.06em 0.04em 0.14em;
    margin-bottom: -0.2em;
  }
  .ln > span {
    display: block;
  }
  .lede {
    margin: 30px auto 0;
    max-width: 52ch;
    text-align: center;
    text-wrap: balance;
  }
  .photo .lede {
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ln > span {
      animation: line 1100ms var(--ease) both;
      animation-delay: calc(80ms + var(--i) * 110ms);
    }
    :global(.js) .lede {
      animation: rise 800ms var(--ease) 380ms both;
    }
    .bg :global(img) {
      animation: drift 30s ease-in-out infinite alternate;
    }
  }
  @keyframes line {
    from {
      transform: translateY(108%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes drift {
    from {
      transform: scale(1.03);
    }
    to {
      transform: scale(1.12) translate3d(-1.5%, 1%, 0);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }
    .name {
      margin-top: 44px;
      font-size: 15vw;
    }
    .lede {
      margin-top: 24px;
      padding: 0 24px;
    }
    .bg {
      height: 78svh;
    }
  }
</style>
