---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Base from '../layouts/Base.astro';
import AlcoTrace from './AlcoTrace.astro';
import Footer from './Footer.astro';
import Haze from './Haze.astro';
import Langs from './Langs.astro';
import { COPY } from '../content/copy';
import { LANGS, SUBWEBS, pagePath, type Lang, type SubwebId } from '../../shared/site';

interface Props {
  lang: Lang;
  /** La ruta sin idioma (/) la sirve el Worker en el idioma del navegador. */
  negotiated: boolean;
}

const { lang, negotiated } = Astro.props;
const t = COPY[lang];
const alternates = [...LANGS.map((l) => ({ lang: l, href: pagePath('home', l) })), { lang: 'x-default', href: '/' }];
// Cada puerta lleva a su subweb, en el mismo idioma que la portada.
const href = (id: SubwebId) => (negotiated ? pagePath(id) : pagePath(id, lang));
/** Canal del osciloscopio: L es ALCO y R es Pol. */
const CHANNEL: Record<SubwebId, string> = { alco: 'L', dev: 'R' };
const NAME = 'Pol Alcoverro';
---

<Base
  lang={lang}
  title={t.title.home}
  description={t.description.home}
  canonical={negotiated ? '/' : pagePath('home', lang)}
  alternates={alternates}
  ogImage="/og/home.png"
  ogLocale={t.ogLocale}
>
  <Haze />
  <div class="page">
    <header class="top">
      <Langs lang={lang} page="home" />
    </header>

    <main class="stage">
      <div class="ident">
        <AlcoTrace label="ALCO" />
        <h1 class="name">
          <span class="sr-only">{NAME}</span>
          <span aria-hidden="true">
            {[...NAME].map((ch, i) => <span class="l" style={`--i: ${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
          </span>
        </h1>
      </div>

      <div class="doors">
        <div class="actions">
          {
            SUBWEBS.map((id, i) => (
              <div class="door" style={`--i: ${i}`}>
                <a class:list={['btn', `btn-${id}`]} href={href(id)} data-door={id}>
                  <span class="row">
                    <span class="ch">{CHANNEL[id]}</span>
                    <span>{t.door[id].label}</span>
                    <ArrowRight size={20} stroke-width={1.5} aria-hidden="true" />
                  </span>
                  <small>{t.door[id].meta}</small>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .top {
    display: flex;
    padding: max(14px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 0
      max(16px, env(safe-area-inset-left));
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(36px, 7vh, 72px);
    padding: 24px max(24px, env(safe-area-inset-right)) 32px max(24px, env(safe-area-inset-left));
    text-align: center;
  }
  .ident {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: 100%;
  }
  /* Al cruzar una puerta, lo que la nombra viaja a la barra de su subweb: el logo a /alco, el nombre a /dev. */
  .ident :global(.trace) {
    width: min(64vw, 980px);
    margin-bottom: clamp(20px, 5vh, 52px);
    view-transition-name: mark-alco;
  }
  .name {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.125rem, 0.85rem + 1vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: 0.6em;
    text-indent: 0.6em;
    text-transform: uppercase;
    white-space: nowrap;
    view-transition-name: mark-dev;
  }
  /* Cada letra es un inline-block para el reveal; sin esto heredaría la sangría del h1. */
  .name .l {
    display: inline-block;
    text-indent: 0;
  }
  .doors {
    display: grid;
    justify-items: center;
    gap: 16px;
  }
  .actions {
    display: flex;
    gap: 16px;
  }
  .door {
    display: grid;
    gap: 10px;
    width: 18.5rem;
  }
  /* Puertas de cristal: sin color propio. El humo (scripts/doors.ts) les pasa en cada fotograma la luz
     que les llega: --light (r g b), --glow (0–1) y --gx (dónde da más fuerte). Su color, melocotón o
     lavanda, solo aparece al señalarlas, igual que los focos. Sin JavaScript, cristal neutro. */
  .btn {
    --fill: var(--lavender);
    --light: 245 242 250;
    --glow: 0;
    --gx: 50%;
    --k: 1;
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 6px;
    min-width: 16rem;
    padding: 14px 18px 15px;
    background:
      radial-gradient(90% 170% at var(--gx) 0%, rgb(var(--light) / calc((0.07 + var(--glow) * 0.28) * var(--k))), transparent 75%),
      rgb(245 242 250 / 0.035);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    backdrop-filter: blur(16px) saturate(1.6);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / calc((0.05 + var(--glow) * 0.22) * var(--k))),
      0 14px 44px -16px rgb(var(--light) / calc(var(--glow) * 0.5 * var(--k)));
    color: var(--silver);
    text-align: left;
    text-decoration: none;
    transition: transform 0.2s var(--ease);
  }
  .btn-alco {
    --fill: var(--peach);
  }
  /* Canto de luz: un borde de 1 px que brilla donde le da el foco. */
  .btn::before,
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .btn::before {
    padding: 1px;
    background: radial-gradient(
      65% 240% at var(--gx) 0%,
      rgb(var(--light) / calc((0.3 + var(--glow) * 0.7) * var(--k))),
      rgb(245 242 250 / 0.1) 75%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }
  /* Al señalarla, el cristal coge el color de su puerta. */
  .btn::after {
    background: linear-gradient(160deg, color-mix(in oklab, var(--fill) 30%, transparent), color-mix(in oklab, var(--fill) 8%, transparent));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--fill) 70%, transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .btn:hover::after,
  .btn:focus-visible::after {
    opacity: 1;
  }
  .btn:active {
    transform: scale(0.98);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .row :global(svg) {
    margin-left: auto;
  }
  .ch {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    background: rgb(var(--light) / calc((0.12 + var(--glow) * 0.25) * var(--k)));
    color: var(--silver);
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background-color 0.35s ease,
      color 0.35s ease;
  }
  .btn:hover .ch,
  .btn:focus-visible .ch {
    background: var(--fill);
    color: var(--ink-dark);
  }
  .btn small {
    font-size: 0.875rem;
    color: var(--dim);
  }

  /* Reveals: mientras el haz dibuja el logo, el nombre sale del desenfoque letra a letra y después
     llegan las dos puertas. «backwards» solo cubre la espera:
     al acabar, cada elemento vuelve a sus propios estilos (hover, pulsado). */
  @media (prefers-reduced-motion: no-preference) {
    .name .l {
      animation: letter 1s var(--ease) backwards;
      animation-delay: calc(1.15s + var(--i) * 40ms);
    }
    .btn {
      animation: door 0.9s var(--ease) backwards;
      animation-delay: calc(1.75s + var(--i) * 120ms);
    }
    .top,
    .page > :global(.foot) {
      animation: fade 1s ease 2.2s backwards;
    }
  }
  @keyframes letter {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.4em);
    }
  }
  @keyframes door {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .stage {
      justify-content: space-between;
      gap: 32px;
      padding-top: 9vh;
    }
    .ident :global(.trace) {
      width: 86vw;
    }
    .doors,
    .actions,
    .door {
      width: 100%;
    }
    .actions {
      flex-direction: column;
      gap: 14px;
    }
    .btn {
      min-width: 0;
      width: 100%;
    }
  }
  @media (max-width: 380px) {
    .name {
      letter-spacing: 0.42em;
      text-indent: 0.42em;
    }
  }
</style>
