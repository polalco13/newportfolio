---
// Marco de las subwebs a partir de la F2: metadatos, tokens comunes y entradas. Cada subweb pone su
// propia cabecera y su pie. `theme` decide el fondo: noche para ALCO (canal L), día para el ingeniero (R).
import '../styles/subweb.css';
import Base from './Base.astro';
import { COPY } from '../content/copy';
import { LANGS, pagePath, type Lang, type SubwebId } from '../../shared/site';

interface Props {
  lang: Lang;
  page: SubwebId;
  /** Las rutas sin idioma (/alco, /dev) se sirven en el idioma del navegador. */
  negotiated: boolean;
  theme: 'night' | 'day';
}

const { lang, page, negotiated, theme } = Astro.props;
const t = COPY[lang];
const alternates = [
  ...LANGS.map((l) => ({ lang: l, href: pagePath(page, l) })),
  { lang: 'x-default', href: pagePath(page) },
];
// Una imagen para compartir por subweb e idioma (scripts/og.mjs): el titular sobre la foto o sobre el papel.
const og = `/og/${page}-${lang}.${page === 'alco' ? 'jpg' : 'png'}`;
const site = Astro.site ?? new URL('https://www.polalco.com');
const url = new URL(negotiated ? pagePath(page) : pagePath(page, lang), site).href;
const pol = { '@id': new URL('/#pol', site).href };
// /alco es un servicio (DJ para eventos); /dev, la página de perfil de la misma persona.
const schema =
  page === 'alco'
    ? [
        {
          '@type': 'Service',
          name: t.title.alco,
          description: t.description.alco,
          serviceType: 'DJ',
          url,
          inLanguage: lang,
          provider: pol,
          areaServed: [
            { '@type': 'City', name: 'Barcelona' },
            { '@type': 'AdministrativeArea', name: 'Catalunya' },
          ],
        },
      ]
    : [{ '@type': 'ProfilePage', name: t.title.dev, description: t.description.dev, url, inLanguage: lang, mainEntity: pol }];
---

<Base
  lang={lang}
  title={t.title[page]}
  description={t.description[page]}
  canonical={negotiated ? pagePath(page) : pagePath(page, lang)}
  alternates={alternates}
  ogImage={og}
  ogAlt={`${t[page].headline.join(' ')} ${t.title[page]}`}
  ogLocale={t.ogLocale}
  schema={schema}
  theme={theme}
>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="ch" data-theme-ground={theme} data-channel={page === 'alco' ? 'L' : 'R'}>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
  </div>
</Base>

<script>
  import '../scripts/subweb';
</script>

<style is:global>
  /* En la página de día, también el fondo de detrás (rebote del scroll, transición entre páginas). */
  body:has([data-theme-ground='day']) {
    background: var(--day);
  }
  /* Solo aparece al llegar con el teclado. */
  .ch .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 18px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .ch .skip:focus-visible {
    transform: none;
    outline-color: var(--paper);
    outline-offset: -4px;
  }
  .ch main:focus {
    outline: none;
  }
</style>
