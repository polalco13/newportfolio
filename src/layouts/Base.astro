---
import '@fontsource-variable/hanken-grotesk';
import fontUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import type { Lang } from '../../shared/site';
import { LINKS } from '../content/copy';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Ruta propia de la página, para la canónica y og:url. */
  canonical: string;
  alternates: { lang: string; href: string }[];
  ogImage: string;
  ogLocale: string;
  noindex?: boolean;
}

const { lang, title, description, canonical, alternates, ogImage, ogLocale, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://www.polalco.com');
const abs = (path: string) => new URL(path, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pol Alcoverro',
  alternateName: 'ALCO',
  url: abs('/'),
  jobTitle: ['Software Engineer', 'DJ'],
  address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
  sameAs: [LINKS.instagram, LINKS.linkedin, LINKS.github],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(canonical)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
    <meta name="theme-color" content="#14111c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="polalco.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(canonical)} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      // Con JavaScript y sin «reducir movimiento», el canvas del haz sustituye al SVG estático.
      // Si en 2 s no ha arrancado, vuelve el SVG.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('beam');
        setTimeout(() => {
          if (!document.querySelector('.trace.live')) document.documentElement.classList.remove('beam');
        }, 2000);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Noche violeta y luces pastel de escenario en el humo. */
    --night: #14111c;
    --silver: #f5f2fa;
    --dim: #cbc5d6;
    --ink-dark: #1a1420;
    --peach: #ffc4a3;
    --lavender: #c9b6ff;
    --beam: #d6cdff;
    --beam-core: #fff6ee;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --font: 'Hanken Grotesk Variable', 'Hanken Grotesk', 'Helvetica Neue', Arial, sans-serif;
    color-scheme: dark;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--night);
    color: var(--silver);
    font: 400 1.0625rem/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--beam);
    outline-offset: 3px;
  }
  ::selection {
    background: var(--beam);
    color: var(--night);
  }
</style>
